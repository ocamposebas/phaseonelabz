---
export const prerender = false;

import BaseLayout from "../../layouts/MainLayout.astro";
import ProductDetailExperience from "../../components/product/ProductDetailExperience.jsx";
import { getProductPageData } from "../../lib/productPageData.js";
import "../../styles/tailwind-product.css";

const { slug = "" } = Astro.params;
const EDGE_LOOKUP_TIMEOUT_MS = 5_000;

let product = null;
let recommendedProducts = [];
let error = "";

async function loadProductDataFromEdge(productSlug) {
  const endpoint = new URL(
    `/api/product/${encodeURIComponent(productSlug)}`,
    Astro.url.origin,
  );
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), EDGE_LOOKUP_TIMEOUT_MS);

  try {
    const response = await fetch(endpoint, {
      headers: {
        Accept: "application/json",
        "User-Agent": "Phase One Product Page/2.0",
      },
      signal: controller.signal,
    });
    const payload = await response.json().catch(() => null);

    if (response.status === 404) {
      return { product: null, recommendedProducts: [] };
    }

    if (!response.ok || !payload?.product) {
      throw new Error(payload?.error || `Product cache returned ${response.status}.`);
    }

    return {
      product: payload.product,
      recommendedProducts: Array.isArray(payload.recommendedProducts)
        ? payload.recommendedProducts
        : [],
    };
  } finally {
    clearTimeout(timeout);
  }
}

try {
  // Production goes through a separately cacheable data route. Development
  // calls the shared loader directly so Astro's local server never self-fetches.
  const pageData = import.meta.env.DEV
    ? await getProductPageData(slug)
    : await loadProductDataFromEdge(slug).catch(async (edgeError) => {
        console.warn("Product edge lookup failed; using origin cache.", edgeError);
        return getProductPageData(slug);
      });

  product = pageData.product;
  recommendedProducts = pageData.recommendedProducts;
} catch (requestError) {
  error = requestError?.message || "Failed to load product.";
}

if (!product && !error) error = "Product not found.";

const pageTitle = product
  ? `${product.name} // Phase One Labz`
  : "Product Not Found";
const pageDescription =
  product?.short_description
    ?.replace(/<[^>]+>/g, " ")
    .replace(/\s+/g, " ")
    .trim() || "Research product detail page.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  {
    product ? (
      <ProductDetailExperience
        product={product}
        recommendedProducts={recommendedProducts}
        client:load
      />
    ) : (
      <section class="min-h-[70vh] px-5 py-32 text-white">
        <div class="mx-auto max-w-3xl rounded-[2rem] border border-red-400/15 bg-red-400/10 p-8 text-center">
          <p class="text-[10px] font-black uppercase tracking-[0.22em] text-red-200">
            Product Error
          </p>

          <h1 class="mt-3 text-3xl font-semibold tracking-[-0.04em]">
            Product not found
          </h1>

          <p class="mt-3 text-sm leading-7 text-red-100/70">
            {error}
          </p>

          <a
            href="/shop"
            class="mt-6 inline-flex rounded-full bg-cyan-300 px-5 py-3 text-[10px] font-black uppercase tracking-[0.18em] text-slate-950"
          >
            Back to shop
          </a>
        </div>
      </section>
    )
  }
</BaseLayout>
