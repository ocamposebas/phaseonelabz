---
import { SimpleGiftsPromotion, SimpleGiftsPromoStrip } from "../components/promos/SimpleGiftsPromotion.jsx";
import "../styles/global.css";

const promo = {
  enabled: true,
  type: "simple_gifts",
  eyebrow: "Limited offer",
  title: "Spend more. Unlock more.",
  info: "Complimentary research catalog gifts unlock at each qualifying tier.",
  ends_at: new Date(Date.now() + 36 * 60 * 60 * 1000).toISOString(),
  cta_label: "Shop the catalog",
  cta_url: "/shop",
  rule: {
    sitewide_label: "10% SITEWIDE",
    tiers: [
      { threshold: 100, rewards: [{ mode: "fixed", options: [{ name: "BPC-157" }] }] },
      { threshold: 200, rewards: [{ mode: "fixed", options: [{ name: "GHK-Cu" }, { name: "KPV" }] }] },
      { threshold: 350, rewards: [{ mode: "choose_one", options: [{ name: "RT" }, { name: "TZ" }, { name: "CAG" }] }] },
      { threshold: 500, rewards: [{ mode: "fixed", options: [{ name: "A Very Long Research Product Name" }] }, { mode: "choose_one", options: [{ name: "Option Alpha" }, { name: "Option Beta" }] }] },
      { threshold: 650, rewards: [{ mode: "fixed", options: [{ name: "Fixed Gift Five" }] }] },
      { threshold: 800, rewards: [{ mode: "choose_one", options: [{ name: "Choice One" }, { name: "Choice Two" }] }] },
    ],
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Promotion preview</title>
  </head>
  <body>
    <SimpleGiftsPromoStrip promo={promo} client:load />
    <SimpleGiftsPromotion promo={promo} client:load />
  </body>
</html>
