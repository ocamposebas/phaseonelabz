---
export const prerender = false;

import BaseLayout from "../layouts/MainLayout.astro";
import StorefrontChrome from "../components/shop/StorefrontChrome.jsx";
import Hero from "../components/hero/Hero.jsx";
import ProductCatalog from "../components/catalog/ProductCatalog.jsx";
import Trust from "../components/hero/TrustSection.jsx";
import RewardsProgram from "../components/rewards/RewardsProgram.jsx";
import ShopByCategorySection from "../components/catalog/ShopByCategorySection.jsx";
import SiteFooter from "../components/footer/SiteFooter.jsx";
import NewsletterSection from "../components/footer/NewsletterSection.jsx";
import ReputationSection from "../components/reputation/ReputationSection.jsx";
import { getSiteControlConfig } from "../lib/siteControl.js";
import "../styles/tailwind-public.css";

const siteControl = await getSiteControlConfig({ background: true });
const promoNow = Date.now();
---

<BaseLayout
  title="Research Compounds // Scientific Catalog"
  description="Research-focused catalog experience for laboratory-use compounds with documentation, COA access, and responsible scientific presentation."
>
  <StorefrontChrome isHome={true} client:load />

  <div class="pt-0">
    <Hero promo={siteControl.promo} promoNow={promoNow} client:load />
    <ShopByCategorySection />
    <ProductCatalog productsEndpoint="/api/products?limit=100" client:visible />
    <Trust />
    <RewardsProgram />
    <NewsletterSection client:visible />
    <SiteFooter />
  </div>

  <ReputationSection client:idle />
</BaseLayout>
