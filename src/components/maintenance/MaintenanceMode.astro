---
interface Props {
  title?: string;
  message?: string;
  supportEmail?: string;
}

const {
  title = "Precision work in progress.",
  message = "We are completing a carefully planned maintenance window and will be back shortly.",
  supportEmail = "support@phaseonelabz.com",
} = Astro.props;
---

<main class="maintenance-mode">
  <div class="maintenance-mode__grid" aria-hidden="true"></div>
  <div class="maintenance-mode__orb maintenance-mode__orb--one" aria-hidden="true"></div>
  <div class="maintenance-mode__orb maintenance-mode__orb--two" aria-hidden="true"></div>

  <section class="maintenance-mode__content">
    <img class="maintenance-mode__logo" src="/TRANSPARENCIA-03.webp" alt="Phase One Labz" />

    <div class="maintenance-mode__visual" aria-hidden="true">
      <span class="maintenance-mode__ring maintenance-mode__ring--outer"></span>
      <span class="maintenance-mode__ring maintenance-mode__ring--middle"></span>
      <span class="maintenance-mode__ring maintenance-mode__ring--inner"></span>
      <span class="maintenance-mode__core">
        <svg viewBox="0 0 48 48" fill="none">
          <path d="M18 7h12M20 7v12.5L11.4 34a4.7 4.7 0 0 0 4 7h17.2a4.7 4.7 0 0 0 4-7L28 19.5V7" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M15.7 32h16.6" stroke="currentColor" stroke-width="2.3" stroke-linecap="round"/>
          <circle cx="22" cy="28" r="1.5" fill="currentColor"/><circle cx="27.5" cy="35.5" r="1" fill="currentColor"/>
        </svg>
      </span>
    </div>

    <div class="maintenance-mode__status"><i></i> Scheduled maintenance</div>
    <h1>{title}</h1>
    <p>{message}</p>

    <div class="maintenance-mode__actions">
      <a href={`mailto:${supportEmail}`}>Contact support</a>
      <button type="button" onclick="window.location.reload()">Check again</button>
    </div>

    <footer>
      <span><i></i> Protected maintenance window</span>
      <span>Phase One Labz · Research infrastructure</span>
    </footer>
  </section>
</main>

<script is:inline>
  window.setInterval(function () {
    fetch("/api/site-control?ts=" + Date.now(), { cache: "no-store" })
      .then(function (response) { return response.ok ? response.json() : null; })
      .then(function (data) {
        if (data && data.maintenance && !data.maintenance.enabled) {
          window.location.reload();
        }
      })
      .catch(function () {});
  }, 15000);
</script>

<style>
  .maintenance-mode {
    position: relative;
    display: grid;
    min-height: 100vh;
    min-height: 100dvh;
    place-items: center;
    overflow: hidden;
    padding: 32px 20px;
    background: #020617;
    color: #fff;
    isolation: isolate;
  }

  .maintenance-mode::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -3;
    background:
      radial-gradient(circle at 50% 34%, rgba(34,211,238,.12), transparent 27%),
      radial-gradient(circle at 12% 90%, rgba(37,99,235,.12), transparent 34%),
      linear-gradient(180deg,#020617,#04101f 52%,#020617);
  }

  .maintenance-mode__grid {
    position: absolute;
    inset: 0;
    z-index: -2;
    opacity: .18;
    background-image: linear-gradient(rgba(103,232,249,.08) 1px, transparent 1px), linear-gradient(90deg,rgba(103,232,249,.08) 1px,transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(circle at center,black,transparent 72%);
  }

  .maintenance-mode__orb { position:absolute; z-index:-1; border-radius:999px; filter:blur(100px); }
  .maintenance-mode__orb--one { top:-12%; right:-8%; width:380px; height:380px; background:rgba(14,165,233,.11); }
  .maintenance-mode__orb--two { bottom:-18%; left:-7%; width:420px; height:420px; background:rgba(59,130,246,.1); }

  .maintenance-mode__content { width:min(100%,720px); text-align:center; }
  .maintenance-mode__logo { width:auto; height:58px; margin:0 auto 34px; object-fit:contain; }

  .maintenance-mode__visual { position:relative; display:grid; width:190px; height:190px; margin:0 auto 28px; place-items:center; }
  .maintenance-mode__ring { position:absolute; border:1px solid rgba(103,232,249,.2); border-radius:50%; }
  .maintenance-mode__ring::before { content:""; position:absolute; top:50%; left:-3px; width:6px; height:6px; border-radius:50%; background:#67e8f9; box-shadow:0 0 16px rgba(103,232,249,.9); }
  .maintenance-mode__ring--outer { inset:0; animation:maintenance-spin 16s linear infinite; }
  .maintenance-mode__ring--middle { inset:23px; border-style:dashed; border-color:rgba(125,211,252,.28); animation:maintenance-spin-reverse 11s linear infinite; }
  .maintenance-mode__ring--inner { inset:47px; border-color:rgba(186,230,253,.3); animation:maintenance-pulse 2.8s ease-in-out infinite; }
  .maintenance-mode__core { display:grid; width:74px; height:74px; place-items:center; border:1px solid rgba(103,232,249,.3); border-radius:24px; background:linear-gradient(145deg,rgba(34,211,238,.13),rgba(2,6,23,.78)); color:#a5f3fc; box-shadow:inset 0 1px 0 rgba(255,255,255,.08),0 0 46px rgba(34,211,238,.13); }
  .maintenance-mode__core svg { width:38px; height:38px; }

  .maintenance-mode__status { display:inline-flex; align-items:center; gap:9px; border:1px solid rgba(103,232,249,.18); border-radius:999px; background:rgba(34,211,238,.055); padding:8px 13px; color:rgba(207,250,254,.72); font-size:9px; font-weight:900; letter-spacing:.2em; text-transform:uppercase; }
  .maintenance-mode__status i { width:7px; height:7px; border-radius:50%; background:#67e8f9; box-shadow:0 0 14px rgba(103,232,249,.8); animation:maintenance-blink 1.8s ease-in-out infinite; }
  .maintenance-mode h1 { max-width:700px; margin:22px auto 0; font-size:clamp(42px,7vw,78px); font-weight:650; line-height:.9; letter-spacing:-.07em; text-wrap:balance; background:linear-gradient(110deg,#fff,#cffafe 48%,#7dd3fc); -webkit-background-clip:text; background-clip:text; color:transparent; }
  .maintenance-mode p { max-width:580px; margin:24px auto 0; color:rgba(203,213,225,.68); font-size:14px; line-height:1.85; text-wrap:balance; }
  .maintenance-mode__actions { display:flex; justify-content:center; gap:10px; margin-top:30px; }
  .maintenance-mode__actions a,.maintenance-mode__actions button { display:inline-flex; min-height:46px; align-items:center; justify-content:center; border:1px solid rgba(103,232,249,.2); border-radius:999px; padding:0 20px; font-family:inherit; color:#cffafe; font-size:9px; font-weight:900; letter-spacing:.14em; text-transform:uppercase; cursor:pointer; transition:transform .18s ease,background .18s ease,border-color .18s ease; }
  .maintenance-mode__actions a { background:#67e8f9; color:#082f49; box-shadow:0 12px 38px rgba(34,211,238,.17); }
  .maintenance-mode__actions button { background:rgba(15,23,42,.42); }
  .maintenance-mode__actions a:hover,.maintenance-mode__actions button:hover { transform:translateY(-2px); border-color:rgba(165,243,252,.55); }
  .maintenance-mode footer { display:flex; justify-content:space-between; gap:20px; margin-top:54px; border-top:1px solid rgba(125,211,252,.09); padding-top:18px; color:rgba(100,116,139,.78); font-size:8px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }
  .maintenance-mode footer span:first-child { display:flex; align-items:center; gap:8px; }
  .maintenance-mode footer i { width:5px; height:5px; border-radius:50%; background:#34d399; box-shadow:0 0 10px rgba(52,211,153,.6); }

  @keyframes maintenance-spin { to { transform:rotate(360deg); } }
  @keyframes maintenance-spin-reverse { to { transform:rotate(-360deg); } }
  @keyframes maintenance-pulse { 50% { transform:scale(1.07); opacity:.55; } }
  @keyframes maintenance-blink { 50% { opacity:.35; } }

  @media(max-width:640px){
    .maintenance-mode { padding:24px 18px; }
    .maintenance-mode__logo { height:48px; margin-bottom:24px; }
    .maintenance-mode__visual { width:150px; height:150px; margin-bottom:22px; }
    .maintenance-mode__ring--middle { inset:18px; }
    .maintenance-mode__ring--inner { inset:37px; }
    .maintenance-mode__core { width:62px; height:62px; border-radius:20px; }
    .maintenance-mode h1 { font-size:clamp(38px,13vw,58px); }
    .maintenance-mode p { margin-top:18px; font-size:12px; line-height:1.7; }
    .maintenance-mode__actions { flex-direction:column; max-width:300px; margin:25px auto 0; }
    .maintenance-mode footer { align-items:center; flex-direction:column; margin-top:38px; }
  }

  @media(prefers-reduced-motion:reduce){.maintenance-mode__ring,.maintenance-mode__status i{animation:none}.maintenance-mode__actions a,.maintenance-mode__actions button{transition:none}}
</style>
