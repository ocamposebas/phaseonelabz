---
import "../styles/global.css";

import GlobalPreloader from "../components/loading/GlobalPreloader.jsx";
import AffiliateCouponTracker from "../components/tracking/AffiliateCouponTracker.jsx";
import MemberAccessGate from "../components/auth/MemberAccessGate.jsx";
import ClientDiagnostics from "../components/monitoring/ClientDiagnostics.astro";
import MaintenanceMode from "../components/maintenance/MaintenanceMode.astro";
import { getSiteControlConfig } from "../lib/siteControl.js";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const siteName = "Phase One Labz";
const siteUrl = "https://phaseonelabz.com";

const {
  title = "Phase One Labz | Premium Research Peptides",
  description = "Phase One Labz provides premium research-use-only peptides and laboratory-focused products for qualified research, educational, and laboratory applications.",
  image = "/TRANSPARENCIA-03.webp",
  noindex = false,
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/$/, "");
const isHome = pathname === "";
const publicAccessPaths = new Set([
  "/account",
  "/register",
  "/forgot-password",
  "/set-password",
]);
const requiresMemberAccess = !publicAccessPaths.has(pathname);
const returnTo = `${Astro.url.pathname}${Astro.url.search}`;
const hasMemberSession = Boolean(
  Astro.cookies.get("lab_auth_token")?.value ||
    Astro.cookies.get("lab_token")?.value ||
    Astro.cookies.get("auth_token")?.value
);

const siteControl = await getSiteControlConfig();
const maintenance = siteControl.maintenance;

if (maintenance.enabled) {
  Astro.response.status = 503;
  Astro.response.headers.set("Retry-After", "900");
  Astro.response.headers.set("Cache-Control", "no-store, max-age=0");
  Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
}

const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(image, siteUrl).toString();

const displayTitle = maintenance.enabled ? "Scheduled Maintenance" : title;
const displayDescription = maintenance.enabled ? maintenance.message : description;
const fullTitle = displayTitle.includes(siteName)
  ? displayTitle
  : `${displayTitle} | ${siteName}`;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteName,
  url: siteUrl,
  logo: `${siteUrl}/TRANSPARENCIA-03.webp`,
  sameAs: [],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteName,
  url: siteUrl,
  description,
};
---

<!doctype html>
<html lang="en" class={isHome ? "is-home-page" : ""}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline src="/pixel.js"></script>

    <title>{fullTitle}</title>

    <meta name="description" content={displayDescription} />
    <meta
      name="robots"
      content={noindex || maintenance.enabled ? "noindex, nofollow" : "index, follow, max-image-preview:large"}
    />

    <link rel="canonical" href={canonicalUrl} />

    <link rel="icon" type="image/png" href="/favicon.png?v=6" />
    <link rel="shortcut icon" type="image/png" href="/favicon.png?v=6" />
    <link rel="apple-touch-icon" href="/favicon.png?v=6" />

    <meta name="theme-color" content="#020617" />
    <meta name="color-scheme" content="dark light" />

    <meta property="og:site_name" content={siteName} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={displayDescription} />
    <meta property="og:type" content={isHome ? "website" : "article"} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={`${siteName} research catalog`} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={displayDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta
      name="classification"
      content="Research-use-only laboratory catalog"
    />
    <meta
      name="keywords"
      content="research peptides, laboratory peptides, research compounds, Phase One Labz, lab use only peptides, educational research peptides"
    />

    <link rel="preconnect" href="https://omnisnippet1.com" crossorigin />
    <link rel="preconnect" href="https://embed.tawk.to" crossorigin />

    <ClientDiagnostics />

    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=AW-18266891349"
    ></script>
    

    <script is:inline>
      window.dataLayer = window.dataLayer || [];

      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("js", new Date());
      gtag("config", "AW-18266891349");
    </script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)}
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(websiteSchema)}
    />

    <style is:global>
      body.phase-cart-open .phase-saved-tab,
      html.phase-cart-open .phase-saved-tab,
      body.phase-cart-open .phase-modal-overlay,
      html.phase-cart-open .phase-modal-overlay {
        opacity: 0 !important;
        pointer-events: none !important;
        visibility: hidden !important;
      }
    </style>
  </head>

  <body class={isHome ? "is-home-page" : ""}>
    {maintenance.enabled ? (
      <MaintenanceMode
        title={maintenance.title}
        message={maintenance.message}
        supportEmail={maintenance.supportEmail}
      />
    ) : (
      <>
        <AffiliateCouponTracker client:load />

        {requiresMemberAccess && (
          <MemberAccessGate client:load returnTo={returnTo} initialHasSession={hasMemberSession} />
        )}

        <GlobalPreloader client:load logoSrc="/TRANSPARENCIA-03.webp" />

        <script is:inline type="text/javascript">
      window.omnisend = window.omnisend || [];
      window.omnisend.push(["brandID", "6a20666d078df331c0cd01d7"]);
      window.omnisend.push(["track", "$pageViewed"]);

      function loadOmnisend() {
        if (window.__phaseOmnisendLoaded) return;
        window.__phaseOmnisendLoaded = true;

        var e = document.createElement("script");
        e.type = "text/javascript";
        e.async = true;
        e.defer = true;
        e.src = "https://omnisnippet1.com/inshop/launcher-v2.js";

        var t = document.getElementsByTagName("script")[0];
        t.parentNode.insertBefore(e, t);
      }

      if ("requestIdleCallback" in window) {
        requestIdleCallback(loadOmnisend, { timeout: 3500 });
      } else {
        window.addEventListener("load", function () {
          setTimeout(loadOmnisend, 1800);
        });
      }
        </script>

        <main class="site-main">
          <slot />
        </main>

        <script is:inline>
          (function () {
            var wasInMaintenance = false;
            window.setInterval(function () {
              fetch("/api/site-control?ts=" + Date.now(), { cache: "no-store" })
                .then(function (response) { return response.ok ? response.json() : null; })
                .then(function (data) {
                  if (data && data.maintenance && data.maintenance.enabled && !wasInMaintenance) {
                    wasInMaintenance = true;
                    window.location.reload();
                  }
                })
                .catch(function () {});
            }, 15000);
          })();
        </script>
      </>
    )}

  </body>
</html>
